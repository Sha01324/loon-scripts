# 通用 Loon 脚本模板

#!name=示例插件
#!desc=演示脚本的 Loon 插件写法

[Script]
# 定时签到（每行一条，argument 里不要写死敏感值的话就留空）
workbuddy-checkin = type=cron,cronexp="0 9 * * *",script-path=https://raw.githubusercontent.com/<USER>/loon-scripts/main/scripts/workbuddy-checkin.js,wake-system=true,timeout=30

[Rewrite]
# 示例：改写请求头
^https?:\/\/api\.workbuddy\.example\.com\/api\/checkin url script-request-header https://raw.githubusercontent.com/<USER>/loon-scripts/main/scripts/workbuddy-checkin.js

[MITM]
hostname = %APPEND% api.workbuddy.example.com
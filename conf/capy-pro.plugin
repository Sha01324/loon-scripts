[MITM]
hostname = %APPEND% api-capyplayer.feifeiduck.cn

[Script]
http-response ^https?://api-capyplayer\.feifeiduck\.cn/api/v1/(subscriptions|devices|subscribe) script-path=https://raw.githubusercontent.com/Sha01324/loon-scripts/main/scripts/capy-pro.js, requires-body=true, timeout=30, tag=capy-pro